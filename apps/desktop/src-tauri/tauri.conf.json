{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TRACE",
  "version": "0.1.0",
  "identifier": "app.trace.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TRACE 档案",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src trace-media: http://trace-media.localhost 'self' asset: http://asset.localhost data:; media-src trace-media: http://trace-media.localhost 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
