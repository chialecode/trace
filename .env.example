# Local real-site test configuration. Copy to .env.local; never put cookies here.
# Values are literal paths relative to this repository; no shell expansion.
TRACE_TEST_BILIBILI_COOKIE_FILE=.local/site-secrets/bilibili.cookie
TRACE_TEST_DOUYIN_COOKIE_FILE=.local/site-secrets/douyin.cookie
TRACE_TEST_WEIBO_COOKIE_FILE=.local/site-secrets/weibo.cookie
TRACE_TEST_XIAOHONGSHU_COOKIE_FILE=.local/site-secrets/xiaohongshu.cookie
TRACE_TEST_INSTAGRAM_COOKIE_FILE=.local/site-secrets/instagram.cookie
TRACE_TEST_X_COOKIE_FILE=.local/site-secrets/x.cookie
TRACE_TEST_TIKTOK_COOKIE_FILE=.local/site-secrets/tiktok.cookie
# Optional proxy for real-site checks when the system proxy is not used; no credentials.
# TRACE_TEST_PROXY=http://127.0.0.1:7890
