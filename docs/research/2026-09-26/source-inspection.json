    {
      "id": "ffmpeg_build_readme",
      "url": "https://raw.githubusercontent.com/BtbN/FFmpeg-Builds/master/README.md",
      "bytes": 2759,
      "sha256": "1ed4437797363166cb9d04b8342987bab307874e2ce238b78bee585d963d92e0",
      "status": "read",
      "relevant_lines": [
        {
          "line": 58,
          "text": "* `gpl` Includes all dependencies, even those that require full GPL instead of just LGPL."
        },
        {
          "line": 59,
          "text": "* `lgpl` Lacking libraries that are GPL-only. Most prominently libx264 and libx265."
        },
        {
          "line": 60,
          "text": "* `nonfree` Includes fdk-aac in addition to all the dependencies of the gpl variant."
        },
        {
          "line": 61,
          "text": "* `gpl-shared` Same as gpl, but comes with the libav* family of shared libs instead of pure static executables."
        },
        {
          "line": 62,
          "text": "* `lgpl-shared` Same again, but with the lgpl set of dependencies."
        },
        {
          "line": 63,
          "text": "* `nonfree-shared` Same again, but with the nonfree set of dependencies."
        }
      ]
