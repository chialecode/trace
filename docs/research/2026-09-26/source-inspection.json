    {
      "id": "naive_changelog",
      "url": "https://raw.githubusercontent.com/tusen-ai/naive-ui/main/CHANGELOG.en-US.md",
      "bytes": 199750,
      "sha256": "305571aa2c40d390105064cf4ec2a8eb9355eb71ee4fd55df722ddf9b1f472bb",
      "status": "read",
      "relevant_lines": [
        {
          "line": 3,
          "text": "## 2.45.3"
        },
        {
          "line": 5,
          "text": "### Fixes"
        },
        {
          "line": 7,
          "text": "- Fix `n-pagination` throwing when jumping from a high page back to page 1."
        },
        {
          "line": 8,
          "text": "- Fix `n-select`, `n-cascader`, `n-tree-select`, `n-date-picker` and `n-time-picker` throwing an error when focus leaves their menu."
        },
        {
          "line": 9,
          "text": "- Fix `n-modal`'s `positive-click`/`negative-click`/`close` events not working with `dialog` and `confirm` presets, and `close` firing twice with `card` preset, closes [#8188](https://github.com/tusen-ai/naive-ui/issues/8188)."
        },
        {
          "line": 11,
          "text": "## 2.45.2"
        },
        {
          "line": 15,
          "text": "### Fixes"
        },
        {
          "line": 17,
          "text": "- Fix `n-ellipsis` throwing when clicked without `expand-trigger`."
        },
        {
          "line": 18,
          "text": "- Fix `n-modal` not closing when clicking the mask."
        },
        {
          "line": 19,
          "text": "- Fix `n-data-table` resetting header horizontal scroll when data becomes empty."
        },
        {
          "line": 21,
          "text": "## 2.45.1"
        },
        {
          "line": 25,
          "text": "### i18n"
        },
        {
          "line": 29,
          "text": "### Fixes"
        },
        {
          "line": 31,
          "text": "- Fix `ugCN` locale not being exported."
        },
        {
          "line": 32,
          "text": "- Fix `n-data-table` and `n-equation` warning `injection \"n-config-provider\" not found` when used without `n-config-provider`."
        },
        {
          "line": 33,
          "text": "- Fix `useDialog` treating `onPositiveClick`, `onNegativeClick` and `onClose` as arrays, closes [#8186](https://github.com/tusen-ai/naive-ui/issues/8186)."
        },
        {
          "line": 34,
          "text": "- Fix `useNotification` treating `onClose` as an array."
        },
        {
          "line": 35,
          "text": "- Fix `n-modal` / `useModal` treating dialog action callbacks as arrays."
        },
        {
          "line": 36,
          "text": "- Fix `n-dropdown` `on-update:show` being called twice."
        },
        {
          "line": 37,
          "text": "- Fix `n-data-table` may throw an error when reactivated inside `keep-alive`."
        },
        {
          "line": 39,
          "text": "## 2.45.0"
        },
        {
          "line": 43,
          "text": "### Breaking Changes"
        }
      ]
    }
  ]
